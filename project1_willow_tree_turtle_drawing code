import turtle
Willow = turtle.Turtle()
window = turtle.Screen()
window.bgcolor("blue")
radius = 100

#Upper half of willow tree
Willow.left(180)
Willow.penup()
Willow.forward(100)
Willow.right(90)
Willow.pendown()
Willow.pensize(10)
Willow.color('light green')
Willow.begin_fill()
Willow.forward(90)
Willow.circle(-radius, 180)
Willow.forward(90)
Willow.right(90)
Willow.forward(200)
Willow.end_fill()

#Willow tree trunk
Willow.penup()
Willow.forward(-80)
Willow.left(90)
Willow.color("brown")
Willow.penup()
Willow.forward(10)
Willow.pendown()

for i in range(2):
    Willow.begin_fill()
    Willow.forward(100)
    Willow.left(90)
    Willow.forward(50)
    Willow.left(90)
    Willow.end_fill()

#Willow tree details
Willow.penup()
Willow.right(90)
Willow.forward(80)
Willow.right(90)
Willow.pendown()
Willow.color("green")
Willow.forward(100)
Willow.circle(-radius, 180)
Willow.forward(100)
Willow.right(90)
Willow.penup()
Willow.forward(15)
Willow.right(90)
Willow.pendown()
Willow.forward(80)
Willow.circle(radius, 70)
Willow.penup()
Willow.left(20)
Willow.forward(50)
Willow.left(50)
Willow.pendown()
Willow.forward(20)
Willow.circle(radius, 40)
Willow.forward(100)
Willow.penup()
Willow.left(90)
Willow.forward(110)
Willow.left(90)
Willow.pendown()
Willow.forward(100)
Willow.circle(radius, 40)
Willow.left(70)
Willow.penup()
Willow.forward(40)
Willow.left(50)
Willow.pendown()
Willow.circle(radius, 20)
Willow.forward(100)
window.exitonclick
